<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <!-- 얼굴추적이 카메라를 쓴다. 이게 없으면 추적이 시작되지 않는다. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- 백라이트 비율은 Settings.System 에 들어간다. Leia 의 정식 API 도
         내부에서 Settings.System.canWrite 를 확인하고 거기에 쓴다.
         adb 로 한 번 허용해야 한다: appops set com.nauty.p3d WRITE_SETTINGS allow -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>

    <uses-feature android:glEsVersion="0x00020000" android:required="true"/>

    <!--
      CNSDK 는 시작하면서 Leia 시스템 패키지 두 개를 조회한다. Android 11+ 의 패키지
      가시성 제한으로 조회가 실패하면 예외를 지우지 않고 다음 JNI 호출로 넘어가
      프로세스가 로그도 없이 abort 된다.

      우리는 targetSdk 28 이라 원래 가시성 제한을 받지 않지만, targetSdk 를 올리는
      순간 걸릴 자리라 미리 선언해 둔다.
    -->
    <queries>
        <!-- 2D→3D 엔진과 모델이 들어 있는 시스템 앱. 이걸 조회하지 못하면
             DexClassLoader 에 넘길 경로를 얻을 수 없다. -->
        <package android:name="com.leiainc.media.service" />
        <package android:name="com.leia.headtrackingservice" />
        <package android:name="com.leialoft.display.config" />
    </queries>

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true">

        <!-- 백라이트 3D 전환 API. 시스템 공유 라이브러리로 정식 선언돼 있다
             (/system/etc/permissions/com.leia.android.lights.xml).
             CNSDK 가 알아서 쓰지만, 없는 기기에서 죽지 않게 required=false. -->
        <uses-library android:name="com.leia.android.lights" android:required="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- 아래는 시험 도구다. 평소 쓰지 않지만 패널 동작을 다시 확인할 때 필요하다. -->

        <!-- 백라이트 비율을 서비스에 묻고 바꾼다. -->
        <activity
            android:name="com.nauty.p3d.leia.LeiaLightsActivity"
            android:exported="true"/>

        <!-- Leia 자신의 2D→3D 엔진(미디어 서비스)이 우리 프로세스에서 도는지
             확인한다. LeiaMediaSDK 주석 참고. -->
        <activity
            android:name="com.nauty.p3d.leia.LeiaMlSpikeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- 정지 SBS 이미지 비교용. 같은 프레임을 여러 방식으로 합성해 번갈아
             띄워 보면 2D→3D 방식 차이가 눈으로 바로 갈린다. -->
        <activity
            android:name="com.nauty.p3d.leia.LeiaImageActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name="com.nauty.p3d.leia.LeiaSpikeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
    </application>
</manifest>
