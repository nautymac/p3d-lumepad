<?xml version="1.0" encoding="utf-8"?>
<!--
  적응형 아이콘 전경. 108x108 중 안전영역(중앙 72x72) 안에 내용을 둔다.

  같은 액자를 좌우로 어긋나게 두 번 그린다 — 이 기기가 하는 일 그대로다.
  액자는 사진, 가운데 삼각형은 영상, 어긋남은 3D.
  색은 청록/자홍 — 스테레오를 나타내는 관례를 그대로 쓴다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 좌안 액자 -->
    <path
        android:strokeColor="#00D8FF"
        android:strokeWidth="6"
        android:strokeAlpha="0.80"
        android:fillColor="#00000000"
        android:pathData="M32,32 L74,32 A8,8 0 0 1 82,40 L82,76 A8,8 0 0 1 74,84
                          L32,84 A8,8 0 0 1 24,76 L24,40 A8,8 0 0 1 32,32 Z" />

    <!-- 우안 액자 -->
    <path
        android:strokeColor="#FF2D6E"
        android:strokeWidth="6"
        android:strokeAlpha="0.92"
        android:fillColor="#00000000"
        android:pathData="M42,24 L84,24 A8,8 0 0 1 92,32 L92,68 A8,8 0 0 1 84,76
                          L42,76 A8,8 0 0 1 34,68 L34,32 A8,8 0 0 1 42,24 Z" />

    <!-- 재생 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M50,42 L50,66 L72,54 Z" />
</vector>
